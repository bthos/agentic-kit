# YAGA probe — Bash
# Investigation: {{INVESTIGATION_ID}}
# Port: replace <PORT> with the value from server.json. Inline as a literal.
# Strip: removed by talaka/shared/debug/tools/debug-strip.sh on cleanup.

curl -s -X POST "http://127.0.0.1:<PORT>/log" -H 'content-type: application/json' --data "{\"id\":\"DEBUG:{{INVESTIGATION_ID}}\",\"probe\":\"p1\",\"file\":\"${BASH_SOURCE[0]}\",\"line\":${LINENO},\"vars\":{}}" >/dev/null 2>&1 || true  # DEBUG:{{INVESTIGATION_ID}}
